{
  "name": "maap-dps-jupyter-extension",
  "version": "2.0.0",
  "description": "A JupyterLab extension for submitting and viewing jobs.",
  "keywords": [
    "dps",
    "jobs",
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/MAAP-Project/dps-jupyter-extension",
  "bugs": {
    "url": "https://github.com/MAAP-Project/dps-jupyter-extension.git/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Marjorie Lucas",
    "email": "marjorie.j.lucas@jpl.nasa.gov"
  },
  "files": [
    "lib/**/*.{css,d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "repository": {
    "type": "git",
    "url": "https://github.com/MAAP-Project/dps-jupyter-extension.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:rollup": "rollup -c",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf maap_dps_jupyter_extension/labextension",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension",
    "install:extension": "jlpm build",
    "lint": "eslint src/",
    "lint:check": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "start": "jupyter lab --config tests/jupyter_server_test_config.py",
    "test": "jlpm playwright test",
    "test:ui": "jlpm playwright test --ui",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "styleModule": "style/index.js",
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "maap_dps_jupyter_extension/labextension",
    "schemaDir": "schema"
  },
  "jupyter-releaser": {
    "hooks": {
      "before-build-npm": [
        "python -m pip install jupyterlab~=4.4",
        "jlpm"
      ],
      "before-build-python": [
        "jlpm clean:all"
      ]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jupyterlab/application": "^4.5.4",
    "@jupyterlab/apputils": "^4.6.4",
    "@jupyterlab/coreutils": "^6.1.8",
    "@jupyterlab/launcher": "^4.5.4",
    "@jupyterlab/settingregistry": "^4.5.4",
    "@jupyterlab/statedb": "^4.5.4",
    "@jupyterlab/ui-components": "^4.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@jupyterlab/builder": "^4.5.4",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/x-date-pickers": "^7.20.0",
    "@tanstack/match-sorter-utils": "^8.15.1",
    "@tanstack/react-table": "^8.20.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.34.0",
    "material-react-table": "^3.0.3",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.57.0"
  }
}
